{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NetLogo",
  "scopeName": "source.netlogo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#procedure-definition" },
    { "include": "#declaration-keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#control-flow" },
    { "include": "#builtin-commands" },
    { "include": "#builtin-reporters" },
    { "include": "#brackets" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.semicolon.netlogo",
      "match": ";.*$"
    },
    "strings": {
      "name": "string.quoted.double.netlogo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.netlogo",
          "match": "\\\\."
        }
      ]
    },
    "procedure-definition": {
      "patterns": [
        {
          "match": "(?i)\\b(to-report|to)\\b\\s+([a-zA-Z_][a-zA-Z0-9_?!#-]*)",
          "captures": {
            "1": { "name": "keyword.control.definition.netlogo" },
            "2": { "name": "entity.name.function.netlogo" }
          }
        },
        {
          "name": "keyword.control.definition.netlogo",
          "match": "(?i)\\bend\\b"
        }
      ]
    },
    "declaration-keywords": {
      "name": "keyword.other.declaration.netlogo",
      "match": "(?i)\\b(globals|breed|directed-link-breed|undirected-link-breed|turtles-own|patches-own|links-own|extensions|__includes)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.netlogo",
          "match": "(?i)\\b(true|false)\\b"
        },
        {
          "name": "constant.language.special.netlogo",
          "match": "(?i)\\b(nobody)\\b"
        },
        {
          "name": "constant.language.math.netlogo",
          "match": "(?i)\\b(e|pi)\\b"
        },
        {
          "name": "constant.language.color.netlogo",
          "match": "(?i)\\b(gray|grey|red|orange|brown|yellow|green|lime|turquoise|cyan|sky|blue|violet|magenta|pink|black|white)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.netlogo",
          "match": "(?<![a-zA-Z0-9_?!#-])(-?\\d+\\.\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.netlogo",
          "match": "(?<![a-zA-Z0-9_?!#-])(-?\\d+)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.netlogo",
          "match": "!=|<=|>=|<|>|="
        },
        {
          "name": "keyword.operator.arithmetic.netlogo",
          "match": "\\+|(?<![a-zA-Z0-9_?!#])-(?![a-zA-Z_])|\\*|/|\\^"
        },
        {
          "name": "keyword.operator.logical.netlogo",
          "match": "(?i)\\b(and|or|not|xor)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.netlogo",
          "match": "(?i)\\b(mod)\\b"
        }
      ]
    },
    "control-flow": {
      "name": "keyword.control.netlogo",
      "match": "(?i)\\b(if|ifelse|ifelse-value|while|repeat|loop|foreach|ask|ask-concurrent|carefully|every|let|set|report|stop|run|runresult|with-local-randomness|without-interruption)\\b"
    },
    "builtin-commands": {
      "name": "support.function.command.netlogo",
      "match": "(?i)\\b(auto-plot-off|auto-plot-on|auto-plot-x-off|auto-plot-x-on|auto-plot-y-off|auto-plot-y-on|back|bk|beep|clear-all|ca|clear-all-plots|clear-drawing|cd|clear-globals|clear-links|clear-output|clear-patches|cp|clear-plot|clear-ticks|clear-turtles|ct|create-link-from|create-link-to|create-link-with|create-links-from|create-links-to|create-links-with|create-ordered-turtles|cro|create-turtles|crt|create-temporary-plot-pen|die|diffuse|diffuse4|display|downhill|downhill4|error|export-all-plots|export-interface|export-output|export-plot|export-view|export-world|face|facexy|file-close|file-close-all|file-delete|file-flush|file-open|file-print|file-show|file-type|file-write|follow|follow-me|forward|fd|hatch|hide-link|hide-turtle|ht|histogram|home|import-drawing|import-pcolors|import-pcolors-rgb|import-world|inspect|jump|layout-circle|layout-radial|layout-spring|layout-tutte|left|lt|move-to|no-display|output-print|output-show|output-type|output-write|pen-down|pd|pen-erase|pe|pen-up|pu|plot|plot-pen-down|plot-pen-reset|plot-pen-up|plotxy|print|random-seed|reset-perspective|rp|reset-ticks|reset-timer|resize-world|ride|ride-me|right|rt|set-current-directory|set-current-plot|set-current-plot-pen|set-default-shape|set-histogram-num-bars|set-patch-size|set-plot-background-color|set-plot-pen-color|set-plot-pen-interval|set-plot-pen-mode|set-plot-x-range|set-plot-y-range|setup-plots|setxy|show|show-link|show-turtle|st|sprout|stamp|stamp-erase|tick|tick-advance|tie|type|untie|update-plots|uphill|uphill4|user-message|wait|watch|watch-me|write)\\b"
    },
    "builtin-reporters": {
      "name": "support.function.reporter.netlogo",
      "match": "(?i)\\b(abs|acos|all\\?|any\\?|approximate-hsb|approximate-rgb|asin|at-points|atan|base-colors|behaviorspace-experiment-name|behaviorspace-run-number|both-ends|but-first|bf|but-last|bl|can-move\\?|ceiling|cos|count|date-and-time|distance|distancexy|dx|dy|empty\\?|end1|end2|error-message|exp|extract-hsb|extract-rgb|file-at-end\\?|file-exists\\?|file-read|file-read-characters|file-read-line|filter|first|floor|fput|hsb|in-cone|in-link-from|in-link-neighbor\\?|in-link-neighbors|in-radius|int|is-agent\\?|is-agentset\\?|is-boolean\\?|is-directed-link\\?|is-link\\?|is-link-set\\?|is-list\\?|is-number\\?|is-patch\\?|is-patch-set\\?|is-string\\?|is-turtle\\?|is-turtle-set\\?|is-undirected-link\\?|is-anonymous-command\\?|is-anonymous-reporter\\?|item|last|length|link|link-heading|link-length|link-neighbor\\?|link-neighbors|link-set|link-shapes|link-with|links|list|ln|log|lput|map|max|max-n-of|max-one-of|max-pxcor|max-pycor|mean|median|member\\?|min|min-n-of|min-one-of|min-pxcor|min-pycor|modes|mouse-down\\?|mouse-inside\\?|mouse-xcor|mouse-ycor|my-in-links|my-links|my-out-links|myself|n-of|n-values|neighbors|neighbors4|netlogo-version|netlogo-web\\?|new-seed|no-links|no-patches|no-turtles|of|one-of|other|other-end|out-link-neighbor\\?|out-link-neighbors|out-link-to|patch|patch-ahead|patch-at|patch-at-heading-and-distance|patch-here|patch-left-and-ahead|patch-right-and-ahead|patch-set|patch-size|patches|plot-name|plot-pen-exists\\?|plot-x-max|plot-x-min|plot-y-max|plot-y-min|position|precision|random|random-exponential|random-float|random-gamma|random-normal|random-poisson|random-pxcor|random-pycor|random-xcor|random-ycor|range|read-from-string|reduce|remainder|remove|remove-duplicates|remove-item|replace-item|reverse|rgb|round|scale-color|self|sentence|se|shade-of\\?|shapes|shuffle|sin|sort|sort-by|sort-on|sqrt|standard-deviation|subject|sublist|substring|subtract-headings|sum|tan|ticks|timer|towards|towardsxy|turtle|turtle-set|turtles|turtles-at|turtles-here|turtles-on|up-to-n-of|user-directory|user-file|user-input|user-new-file|user-one-of|user-yes-or-no\\?|variance|with|with-max|with-min|word|world-height|world-width|wrap-color)\\b"
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.bracket.square.netlogo",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.netlogo",
          "match": "[()]"
        }
      ]
    }
  }
}
