{
  "Procedure": {
    "prefix": "to",
    "body": ["to ${1:name}${2: [${3:args}]}", "  $0", "end"],
    "description": "Define a procedure"
  },
  "Reporter": {
    "prefix": "to-report",
    "body": ["to-report ${1:name}${2: [${3:args}]}", "  report $0", "end"],
    "description": "Define a reporter procedure"
  },
  "Ask": {
    "prefix": "ask",
    "body": ["ask ${1:turtles} [", "  $0", "]"],
    "description": "Ask an agentset to run commands"
  },
  "Ask with filter": {
    "prefix": "askwith",
    "body": ["ask ${1:turtles} with [${2:condition}] [", "  $0", "]"],
    "description": "Ask a filtered agentset to run commands"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} [", "  $0", "]"],
    "description": "Conditional"
  },
  "If/else": {
    "prefix": "ifelse",
    "body": ["ifelse ${1:condition} [", "  $2", "] [", "  $0", "]"],
    "description": "Two-branch conditional"
  },
  "Multi-branch ifelse": {
    "prefix": "ifelse-multi",
    "body": [
      "(ifelse",
      "  ${1:condition1} [ $2 ]",
      "  ${3:condition2} [ $4 ]",
      "  [ $0 ]",
      ")"
    ],
    "description": "Multi-branch ifelse (NetLogo 6.1+)"
  },
  "While": {
    "prefix": "while",
    "body": ["while [${1:condition}] [", "  $0", "]"],
    "description": "While loop"
  },
  "Repeat": {
    "prefix": "repeat",
    "body": ["repeat ${1:n} [", "  $0", "]"],
    "description": "Repeat a fixed number of times"
  },
  "Foreach": {
    "prefix": "foreach",
    "body": ["foreach ${1:list} [ ${2:x} ->", "  $0", "]"],
    "description": "Iterate over a list"
  },
  "Let": {
    "prefix": "let",
    "body": ["let ${1:name} ${0:value}"],
    "description": "Declare a local variable"
  },
  "Carefully": {
    "prefix": "carefully",
    "body": ["carefully [", "  $1", "] [", "  ${0:print error-message}", "]"],
    "description": "Run commands, handling any runtime error"
  },
  "Create turtles": {
    "prefix": "create-turtles",
    "body": ["create-turtles ${1:n} [", "  $0", "]"],
    "description": "Create turtles and initialise them"
  },
  "Hatch": {
    "prefix": "hatch",
    "body": ["hatch ${1:n} [", "  $0", "]"],
    "description": "Hatch new turtles from the current turtle"
  },
  "Sprout": {
    "prefix": "sprout",
    "body": ["sprout ${1:n} [", "  $0", "]"],
    "description": "Sprout turtles from the current patch"
  },
  "Setup procedure": {
    "prefix": "setup",
    "body": ["to setup", "  clear-all", "  $0", "  reset-ticks", "end"],
    "description": "Standard setup procedure"
  },
  "Go procedure": {
    "prefix": "go",
    "body": ["to go", "  $0", "  tick", "end"],
    "description": "Standard go procedure"
  },
  "Globals block": {
    "prefix": "globals",
    "body": ["globals [", "  $0", "]"],
    "description": "Declare global variables"
  },
  "Breed": {
    "prefix": "breed",
    "body": ["breed [${1:plural} ${2:singular}]"],
    "description": "Declare a turtle breed"
  },
  "Turtles-own": {
    "prefix": "turtles-own",
    "body": ["turtles-own [", "  $0", "]"],
    "description": "Declare turtle variables"
  },
  "Patches-own": {
    "prefix": "patches-own",
    "body": ["patches-own [", "  $0", "]"],
    "description": "Declare patch variables"
  },
  "Includes": {
    "prefix": "__includes",
    "body": ["__includes [ \"${1:file}.nls\" ]"],
    "description": "Include external NetLogo source files"
  },
  "Extensions": {
    "prefix": "extensions",
    "body": ["extensions [${1:table}]"],
    "description": "Load NetLogo extensions"
  }
}
